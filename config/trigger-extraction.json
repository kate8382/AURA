{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "AURA trigger-extraction rules (Issue #8): lightweight, deterministic, English-only heuristics mapping scenarios[].text to canonical trigger labels from config/signal-mapping.json. Every rule trigger MUST already exist in the canonical vocabulary; unknown labels are a configuration error. This file is rule-based surface matching, not semantic understanding.",
  "language": "en",
  "stopwords": [
    "a", "an", "the", "and", "or", "but", "if", "then", "else", "when", "while",
    "of", "at", "by", "for", "with", "about", "into", "through", "during",
    "before", "after", "above", "below", "to", "from", "up", "down", "in",
    "out", "on", "off", "over", "under", "again", "further", "once", "here",
    "there", "where", "why", "how", "all", "any", "both", "each", "few",
    "more", "most", "other", "some", "such", "no", "nor", "not", "only",
    "own", "same", "so", "than", "too", "very", "can", "will", "just",
    "don", "t", "should", "now", "i", "me", "my", "myself", "we", "our",
    "ours", "ourselves", "you", "your", "yours", "yourself", "yourselves",
    "he", "him", "his", "himself", "she", "her", "hers", "herself", "it",
    "its", "itself", "they", "them", "their", "theirs", "themselves",
    "what", "which", "who", "whom", "this", "that", "these", "those",
    "am", "is", "are", "was", "were", "be", "been", "being", "have",
    "has", "had", "having", "do", "does", "did", "doing", "would", "could",
    "ought", "need", "needs", "needed", "please", "really", "also", "as",
    "because", "until", "s", "m", "re", "ve", "d", "ll"
  ],
  "scoring": {
    "threshold": 0.5,
    "minMatches": 2
  },
  "regexRules": [
    {
      "trigger": "false naivety / persona discrepancy",
      "pattern": "\\bi\\s+don'?t\\s+know\\s+anything\\s+about\\b",
      "description": "Naive disavowal ('I don't know anything about X') while naming technical methods."
    },
    {
      "trigger": "unjustified domain knowledge",
      "pattern": "\\bi\\s+don'?t\\s+know\\s+anything\\s+about\\b",
      "description": "Same disavowal: naming precise techniques right after claiming ignorance."
    },
    {
      "trigger": "false naivety / persona discrepancy",
      "pattern": "\\bi\\s+know\\s+zero\\s+about\\b",
      "description": "Alternate naive disavowal ('I know zero about X')."
    },
    {
      "trigger": "unjustified domain knowledge",
      "pattern": "\\bi\\s+know\\s+zero\\s+about\\b",
      "description": "Same alternate disavowal paired with technical vocabulary."
    },
    {
      "trigger": "unjustified domain knowledge",
      "pattern": "\\bsomeone\\s+(on\\s+the\\s+internet\\s+|online\\s+|on\\s+a\\s+forum\\s+)?(said|told\\s+me)\\b",
      "description": "Secondhand-expertise cue ('someone online said/told me') paired with precise methods."
    },
    {
      "trigger": "academic & student alibi",
      "pattern": "\\bthes[ie]s\\b",
      "description": "Thesis framing (thesis/theses)."
    },
    {
      "trigger": "hollywood script bypass / creative framing",
      "pattern": "\\bmovie\\s+script\\b",
      "description": "Creative-work framing for disallowed asset requests."
    },
    {
      "trigger": "compliance evasion",
      "pattern": "\\bdon'?t\\s+have\\b.{0,80}\\bofficial\\b",
      "description": "Missing-authorization admission ('don't have ... official ...')."
    },
    {
      "trigger": "ethical justification / alibi",
      "pattern": "\\bit'?s\\s+just\\s+for\\s+my\\s+(official|preliminary)\\b",
      "description": "Minimizing official-purpose alibi (\"it's just for my official ...\")."
    },
    {
      "trigger": "ethical justification / alibi",
      "pattern": "\\bi\\s+just\\s+want\\s+to\\s+(show|prove|demonstrate|verify|check)\\b",
      "description": "Benign-intent framing (\"I just want to show/prove ...\")."
    },
    {
      "trigger": "unauthorized action alibi",
      "pattern": "\\bnever\\s+(made|authorized)\\s+this\\s+(purchase|transaction)\\b",
      "description": "Fraud-dispute alibi ('never made/authorized this purchase/transaction')."
    },
    {
      "trigger": "professional camouflage",
      "pattern": "\\bi\\s+am\\s+a\\s+professional\\b",
      "description": "Professional-role self-framing ('I am a professional ...')."
    },
    {
      "trigger": "shared account camouflage",
      "pattern": "\\bshared\\b[^.\\n]{0,40}\\baccount\\b",
      "description": "Shared-ownership claim with an optional service gap ('shared Instagram account'). Single-sentence only."
    },
    {
      "trigger": "non-consensual pattern generation",
      "pattern": "\\bgenerate\\s+\\d+\\b",
      "description": "Bulk-generation demand ('generate 50 ...')."
    },
    {
      "trigger": "non-public intelligence demand",
      "pattern": "\\bnon[\\s-]*public\\b",
      "description": "Explicit non-public/private data demand."
    },
    {
      "trigger": "urgency / pressure",
      "pattern": "\\b(right\\s+now|as\\s+soon\\s+as\\s+possible|asap|by\\s+tonight|by\\s+tomorrow|hard\\s+deadline|running\\s+out\\s+of\\s+time)\\b",
      "description": "Explicit deadline/time-pressure language. NOTE: bare 'immediately/immediate' is deliberately excluded: in the curated corpus it usually marks fraud-dispute or threat wording, not urgency framing."
    }
  ],
