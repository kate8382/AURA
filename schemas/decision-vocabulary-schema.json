{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURA Decision Vocabulary Schema",
  "type": "object",
  "required": [
    "version",
    "severities",
    "workflow_states"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "severities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "rank",
          "description"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "rank": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "workflow_states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "description"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}