{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURA Signal Mapping Schema",
  "type": "object",
  "required": [
    "signals"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "signals": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9:_-]+$": {
          "type": "object",
          "required": [
            "id",
            "description",
            "triggers"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "implied_action": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "egress:outbound",
                  "execute:command",
                  "disclosure:external",
                  "access:privilege"
                ]
              },
              "uniqueItems": true
            },
            "triggers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}