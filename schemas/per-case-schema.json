{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURA per-case schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "case_id",
    "category",
    "scenarios"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(SC|RC)-[A-Z]-\\d{3,}$",
      "description": "Case ID: SC- for synthetic cases or RC- for real cases, then a domain letter and a sequence number, for example SC-A-001 or RC-M-001."
    },
    "domain": {
      "type": "string",
      "description": "Optional top-level domain for filtering and routing."
    },
    "category": {
      "type": "string"
    },
    "case_type": {
      "type": "string",
      "enum": [
        "synthetic",
        "real"
      ],
      "description": "Optional marker for the origin of the case. When absent, the case is treated as synthetic for backward compatibility."
    },
    "provenance": {
      "type": "object",
      "description": "Optional source metadata for real cases. Recorded for audit and attribution; all fields are optional.",
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string",
          "description": "Name of the source dataset or project, for example 'Lakera gandalf'."
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Source ID of the entry in real_cases/NOTICE.md, for example 'deepset-prompt-injections'. Required for real cases."
        },
        "source_url": {
          "type": "string",
          "description": "URL or web address of the source dataset or project page."
        },
        "original_id": {
          "type": "string",
          "description": "Identifier of this case in the original source dataset."
        },
        "language": {
          "type": "string",
          "description": "Language code of the case text, for example 'en' or 'ru'."
        },
        "collected_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date the case was collected, in ISO-8601 format YYYY-MM-DD."
        },
        "redaction_status": {
          "type": "string",
          "enum": [
            "none",
            "redacted",
            "sanitized",
            "pointer_only",
            "full_text"
          ],
          "description": "How the text was treated before storage: 'none' (unchanged), 'redacted' (personal data or secrets replaced), 'sanitized' (harmful details removed or paraphrased), 'full_text' (original text stored, allowed by the source license), or 'pointer_only' (only a link and hash are stored)."
        },
        "license": {
          "type": "string",
          "description": "License identifier of the source, for example 'Apache-2.0' or 'MIT'. Must match the entry in real_cases/NOTICE.md."
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Authors or copyright holders of the source, as required for attribution."
        },
        "attribution": {
          "type": "string",
          "description": "Attribution or credit string required by the source license (e.g., 'Credit AllenAI and ODC-BY terms')."
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "SHA-256 hash of the original source content, used for pointer_only items."
        }
      }
    },
    "signal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional list of standardized signal IDs. Signal IDs may be derived or applied in a later normalization step."
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "text"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "declared_shape": {
            "type": "object",
            "description": "Optional scenario-level declared shape metadata for trial engines.",
            "properties": {
              "operation_type": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "negative_labels": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "confirmed_negative",
                  "benign",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "declared_shape": {
      "type": "object",
      "description": "Case-level declared shape metadata used by trial engines for safe rule evaluation. Written by normalization for every case (empty operation_type allowed when unknown). Signal IDs are taken from the case-level signal_ids. Placed after negative_labels in canonical key order.",
      "properties": {
        "operation_type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "negative_labels": {
      "type": "object",
      "description": "Optional explicit negative/benign/unknown case classification used to distinguish confirmed negatives from unknown cases.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmed_negative",
            "benign",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "suggested_action": {
      "type": "string"
    },
    "legal_risk": {
      "type": "object",
      "required": [
        "short_summary",
        "full_text"
      ],
      "properties": {
        "short_summary": {
          "type": "string"
        },
        "full_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "behavioral_patterns": {
      "type": "object",
      "required": [
        "short_summary",
        "full_text"
      ],
      "properties": {
        "short_summary": {
          "type": "string"
        },
        "full_text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "cross_check": {
      "type": "object",
      "properties": {
        "short_summary": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "type"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "boolean",
                      "enum",
                      "number",
                      "string",
                      "datetime"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "hard",
                      "soft",
                      "info"
                    ]
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "threshold": {
                    "type": "object",
                    "required": [
                      "operator",
                      "value"
                    ],
                    "properties": {
                      "operator": {
                        "type": "string"
                      },
                      "value": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": true
                  },
                  "evidence_weight": {
                    "type": "number",
                    "minimum": 0
                  },
                  "enforcement": {
                    "type": "object",
                    "properties": {
                      "actionOnFail": {
                        "type": "string",
                        "enum": [
                          "veto",
                          "require_manual_review",
                          "mark_pending"
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "name",
                  "full_text"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "full_text": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "deception_threshold": {
      "type": "object",
      "required": [
        "short_summary",
        "full_text"
      ],
      "properties": {
        "short_summary": {
          "type": "string"
        },
        "full_text": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "export_date": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "anonymized": {
      "type": "boolean"
    },
    "confidence_raw": {
      "type": "number",
      "minimum": 0
    },
    "annotation": {
      "type": "string",
      "description": "Optional freeform annotation for external trial engines and review workflows."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Optional. Populated by recalc_confidence.ts; absent in source templates."
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "review",
        "block",
        "pending"
      ],
      "description": "Optional. Populated by normalize-percases.ts / recalc_confidence.ts; absent in source templates."
    },
    "decision_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional list of strings explaining why a decision was made (populated by PolicyEvaluator)."
    }
  }
}