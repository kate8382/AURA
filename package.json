  "scripts": {
    "validate": "node -r ts-node/register scripts/validate-percases.ts synthetic_cases",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest scripts/__tests__/pipeline-integration.test.ts",
    "check:errors": "node -r ts-node/register scripts/tools/check-error-handling.ts",
    "recalc:confidence": "node -r ts-node/register scripts/recalc_confidence.ts",
    "recalc:confidence:real": "node -r ts-node/register scripts/recalc_confidence.ts --dir real_cases --dry-run",
    "recalc:confidence:real:apply": "node -r ts-node/register scripts/recalc_confidence.ts --dir real_cases --allow-real-write",
    "recalc:confidence:dry": "node -r ts-node/register scripts/recalc_confidence.ts --dry-run",
    "recalc:confidence:min": "node -r ts-node/register scripts/recalc_confidence.ts --min 0.0",
    "example:recalc": "node -r ts-node/register examples/simple-recalc.ts examples/sample_case.json",
    "new-case:dry": "node -r ts-node/register scripts/new-case-template.ts --dry-run",
    "new-case": "node -r ts-node/register scripts/new-case-template.ts",
    "new-case:real": "node -r ts-node/register scripts/new-case-template.ts --dir real_cases --dry-run",
    "normalize:percases:dry": "node -r ts-node/register scripts/normalize-percases.ts synthetic_cases --dry-run",
    "normalize:percases:real:dry": "node -r ts-node/register scripts/normalize-percases.ts --dir real_cases --dry-run",
    "normalize:percases": "node -r ts-node/register scripts/normalize-percases.ts synthetic_cases -- --apply-signal-ids",
    "normalize:percases:real": "node -r ts-node/register scripts/normalize-percases.ts --dir real_cases",
    "normalize:percases:extract:dry": "node -r ts-node/register scripts/normalize-percases.ts synthetic_cases --dry-run --extract-triggers",
    "normalize:percases:extract": "node -r ts-node/register scripts/normalize-percases.ts synthetic_cases --extract-triggers",
    "validate:percases": "node -r ts-node/register scripts/validate-percases.ts synthetic_cases",
    "validate:real": "node -r ts-node/register scripts/validate-percases.ts real_cases",
    "validate:triggers": "node -r ts-node/register scripts/tools/validate-triggers.ts",
    "clean:synthetic_cases": "node -r ts-node/register scripts/tools/clean-cases.ts",
    "gen:triggers": "node -r ts-node/register scripts/generate-trigger-weights.ts",
    "gen:triggers:real": "node -r ts-node/register scripts/generate-trigger-weights.ts --include-real",
    "gen:triggers:apply": "node -r ts-node/register scripts/generate-trigger-weights.ts -- --apply-signal-ids",
    "gen:signal-hash": "node -r ts-node/register scripts/tools/generate-signal-hash.ts",
    "collect:triggers": "node -r ts-node/register scripts/tools/collect-triggers.js",
    "audit:categories": "node -r ts-node/register scripts/tools/audit-categories.js",
    "migrate:categories": "node -r ts-node/register scripts/tools/migrate-categories.ts",
    "migrate:signals": "node -r ts-node/register scripts/tools/migrate-signal-ids.ts",
    "decisions:show": "node -r ts-node/register scripts/tools/show-decisions.ts synthetic_cases",
    "decisions:validate": "node -r ts-node/register scripts/tools/show-decisions.ts --validate synthetic_cases",
    "crosscheck:run": "node -r ts-node/register scripts/policy/crossCheckAdapter.ts",
    "crosscheck:validate": "node -r ts-node/register scripts/policy/crossCheckAdapter.ts --validate",
    "trial:engine": "node -r ts-node/register scripts/tools/trial-engine.ts",
    "test:crosscheck": "jest scripts/__tests__/crosscheck.test.ts",
    "update:traffic": "node .github/scripts/fetch-traffic-snapshot.js",
    "backfill:traffic": "node .github/scripts/backfill-traffic-history.js",
    "generate:traffic-report": "node .github/scripts/generate-traffic-report.js",
    "generate:traffic-summary": "node .github/scripts/generate-traffic-summary.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^25.9.1",
    "ajv": "^8.20.0",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}