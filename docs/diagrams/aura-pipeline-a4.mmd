flowchart LR
  %% Compact A4-friendly AURA pipeline

  Start["Start: run recalc_confidence"] --> Load["Load configs & mappings"]
  Load --> Input["Cases (public_cases/ or file)"]
  Input --> Extract["Extract: category, scenarios, signal_ids, cross_check"]

  subgraph T[Triggers]
    Extract --> Collect["Collect & normalize triggers"]
    Collect --> Resolve["Resolve mapped signal_ids -> triggers"]
    Resolve --> Weights["Lookup per-trigger weight"]
    Weights --> Sum["Sum unique trigger weights"]
  end

  subgraph R[Raw evidence]
    Sum --> CrossAdd["+ crossCheckQ * CROSS_CHECK_WEIGHT"]
    CrossAdd --> UnmappedAdd["+ unmappedSignalCount * SIGNAL_ID_WEIGHT"]
    UnmappedAdd --> RawSum["confidence_raw = sum + categoryMultiplier"]
  end

  subgraph N[Normalize]
    RawSum --> Norm["confidence = 1 - exp(-alpha * confidence_raw)"]
    Norm --> DecisionEval["PolicyEvaluator.evaluate(case) -> decision + reasons"]
  end

  DecisionEval --> Save["Write updated JSON (reorder keys) & exit"]

  %% compact legend
  classDef legend fill:#f8f9fa,stroke:#ddd
  Legend["Legend:\nconfidence_raw = audit sum (may >1)\nconfidence in [0..1]: 1 - e^{-alpha*raw}"]:::legend
  Save --> Legend
