flowchart TD
  %% Input / startup
  A["Start: run recalc_confidence (scripts/recalc_confidence.ts)"] --> B[Load configs & mappings]
  B --> B1["loadTriggerConfig() (config/trigger-weights.json or FALLBACK)"]
  B --> B2["loadPolicyConfig() (config/policy.json)"]
  B --> B3["Load signal-mapping (config/signal-mapping.json) if present"]

  subgraph INPUT[Input data]
    C["Case JSON(s) from public_cases/ or file"]
  end

  C --> D["Extract: category, scenarios[], signal_ids, cross_check"]

  subgraph TRIGGERS[Step 1: Triggers Processing]
    D --> T1["Collect triggers from scenarios[].triggers"]
    T1 --> T2["Normalize triggers (trim/lowercase)"]
    T2 --> T3[Unique triggers set]
    T3 --> T4[Resolve signal_ids -> mapped triggers via signal-mapping]
    T4 --> T5[Expand mapped triggers into Unique triggers; count unmappedSignalCount]
    T5 --> T6["Look up per-trigger weight: TRIGGER_WEIGHTS[key] or DEFAULT_TRIGGER_WEIGHT"]
    T6 --> TW["totalTriggerWeight = sum(per-trigger weights)"]
  end

  subgraph IDS_DECISION[Step 2: IDs & Decision-related processing]
    TW --> I1[Add cross-check contribution: crossCheckQuestions * CROSS_CHECK_WEIGHT]
    I1 --> I2[Add unmapped signal IDs contribution: unmappedSignalCount * SIGNAL_ID_WEIGHT]
    I2 --> TOTAL[totalWeight = totalTriggerWeight + crossCheck + unmappedSignals]
    TOTAL --> MAX["boost = min(MAX_BOOST, totalWeight)"]
    MAX --> NOTE["default values from config.ts:<br/>DEFAULT_TRIGGER_WEIGHT = 0.01<br/>CROSS_CHECK_WEIGHT = 0.005<br/>SIGNAL_ID_WEIGHT = 0.01<br/>MAX_BOOST = 0.10"]
  end

  subgraph RAW_CONF[Step 3: Compute confidence_raw]
    D --> RAW_BASE["get rawVal = case.confidence_raw || old confidence || PROMPT_BASE (0.0)"]
    RAW_BASE --> BASE_CAT["base = getBaseForCategory(category)"]
    BASE_CAT --> BOOST_SUM["boost (from previous step)"]
    BOOST_SUM --> SUM_VAL[sum = base + boost]
    SUM_VAL --> CLAMP["confidence_calc = round(sum, 2); confidence = min(1.0, confidence_calc)"]
    CLAMP --> OUT_CONF["Set case.confidence_raw (if undefined) := rawVal; set case.confidence := confidence"]
  end

  subgraph POLICY[Step 4: Policy Evaluation & Decision]
    OUT_CONF --> P1["PolicyEvaluator.evaluate(case)"]
    P1 --> P2[Checks: veto_triggers, cross-check history, failed requirements]
    P2 --> P3[Compare confidence vs thresholds: review_threshold, block_threshold]
    P3 --> P4["Return decision: allow|pending|review|block + reasons"]
    P4 --> FINAL[Attach decision and decision_reasons to case]
  end

  FINAL --> SAVE["Write updated JSON to disk (reorder keys) and exit"]

  %% Annotations: why confidence can hit 1.0
  classDef warn fill:#fff3cd,stroke:#ffeeba;
  WNOTE[/Why confidence==1.0?/]:::warn
  SUM_VAL --> WNOTE
  WNOTE --> W1["__p49__<br/>base+boost >= 1.0 -> clamped to 1.0"]
  WNOTE --> W2["__p50__<br/>so confidence_raw=0.0 is possible while computed confidence==1.0"]

  %% Expose formulas inline for clarity
  click BASE_CAT " " "Base per category: see RecalcConfidence.getBaseForCategory()"
  click MAX " " "Boost = min(MAX_BOOST, totalWeight)"
  click CLAMP " " "confidence = min(1.0, round((base+boost),2))"

  style WNOTE fill:#fff3cd,stroke:#f0ad4e

  %% End