%% Mermaid diagram: AURA pipeline v4 (Release v0.2.0)
%% Place this file in docs/diagrams and generate PNG with mermaid-cli (mmdc)

flowchart LR
  %% Dataset sources
  SC["synthetic_cases\n(JSON files)"]
  RCASE["real_cases\n(provenance + licensing, see NOTICE)"]
  BC["benign_cases\n(safe and clarify, synthetic/real)"]
  CFG["config/\n(trigger-extraction.json, signal-mapping.json,\ntrigger-weights.json, decision-vocabulary.json)"]
  SNAP["config/snapshots/\n(bounty-programs.json)"]
  TRUST["config/trusted-keys/\n(*.asc + manifest.json)"]

  subgraph Config_and_Contract
    direction TB
    VC["Static config validation\n(scripts/tools/validate-triggers.ts)"]
    SCH["Schemas + AJV\n(schemas/per-case-schema.json)"]
    VOC["Decision vocabulary +\nsignal catalog hash\n(scripts/tools/generate-signal-hash.ts)"]
  end

  subgraph Normalization
    direction TB
    N["NormalizePerCases\n(scripts/normalize-percases.ts)"]
    E["Extractor\n(scripts/extract-triggers.ts)"]
    VP["ValidatePerCases\n(scripts/validate-percases.ts)"]
  end

  subgraph Weighting_and_Mapping
    direction TB
    GW["GenerateTriggerWeights\n(scripts/generate-trigger-weights.ts)"]
    MAP["Signal Mapping + implied actions\n(config/signal-mapping.json)"]
    TW["Trigger Weights\n(config/trigger-weights.json)"]
  end

  subgraph Recalc_and_Policy
    direction TB
    RC["RecalcConfidence\n(scripts/recalc_confidence.ts)"]
    CC["CrossCheckAdapter\n(scripts/policy/crossCheckAdapter.ts)\nbounty-scope"]
    PGP["pgp-verify adapter\n(scripts/policy/pgp/)"]
    PE["PolicyEvaluator\n(scripts/policy/evaluateDecision.ts)"]
  end

  subgraph Trial_and_Metrics
    direction TB
    TE["Trial engine + FPR\n(scripts/tools/trial-engine.ts)"]
    SM["Declared-shape / negative-label\nmetadata (scripts/tools/shape-metadata-consumer.ts)"]
  end

  subgraph CI_and_Tests
    direction TB
    T["Jest tests\n(scripts/__tests__)"]
    KEYS["Trusted-key policy validator\n(scripts/tools/validate-trusted-keys.ts)"]
    WF[".github/workflows/ci.yml\n(typecheck, validate:keys, tests)"]
  end

  %% Flow arrows
  SC --> N
  RCASE --> N
  BC --> N
  N -->|"--extract-triggers (opt-in)"| E
  E --> GW
  CFG --> E
  CFG --> GW
  CFG --> VC
  VC --> E
  SCH --> VP
  N --> VP
  GW --> MAP
  GW --> TW
  VOC --> MAP
  MAP --> RC
  TW --> RC
  N -->|"--apply-signal-ids (opt-in)"| GW
  SNAP --> CC
  TRUST --> PGP
  RC --> CC
  RC --> PGP
  RC --> PE
  CC --> RC
  PGP --> RC
  PE --> RC
  RC --> TE
  SM --> TE
  MAP -->|"implied action taxonomy"| PE

  %% Outputs
  RC --> OUT["Normalized & recalculated\ncases (JSON)\n(reports, audit fields)"]
  GW -->|"writes"| TW
  MAP -->|"canonical vocab used by extractor"| E

  %% Tests / CI connections
  T --> E
  T --> GW
  T --> RC
  T --> PGP
  TRUST --> KEYS
  WF --> T
  WF --> KEYS
  WF --> GW
  WF --> RC
  WF --> VP

  %% Notes
  classDef cfg fill:#f9f,stroke:#333,stroke-width:1px;
  classDef policy fill:#bbf,stroke:#333,stroke-width:1px;
  class CFG,MAP,TW,SNAP,TRUST cfg;
  class CC,PGP,PE,KEYS policy;
